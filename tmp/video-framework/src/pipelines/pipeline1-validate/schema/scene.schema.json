{
  "$id": "scene.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "narrationRef", "assets"],
  "properties": {
    "id": { "type": "string" },
    "narrationRef": {
      "type": "string",
      "description": "id into manifest.narration.entries; resolved timing drives this scene's duration"
    },
    "transitionIn": { "$ref": "#/definitions/transitionRef" },
    "transitionOut": { "$ref": "#/definitions/transitionRef" },
    "background": { "$ref": "#/definitions/tokenOrLiteral" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetType", "anchor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "assetType": { "type": "string", "description": "must match a folder name under src/assets" },
          "anchor": {
            "type": "object",
            "required": ["position"],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
              },
              "offsetXPercent": { "type": "number", "default": 0 },
              "offsetYPercent": { "type": "number", "default": 0 }
            }
          },
          "contentOverride": { "type": "object" },
          "styleOverride": { "type": "object" },
          "enterAt": { "type": "number", "minimum": 0, "maximum": 1, "description": "fraction of scene duration" },
          "exitAt": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "definitions": {
    "tokenOrLiteral": {
      "oneOf": [
        { "type": "string", "description": "a style registry token, e.g. 'shade1'" },
        { "type": "object" }
      ]
    },
    "transitionRef": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "'default' or a folder name under src/transitions" },
        "durationInFrames": { "type": "number" },
        "params": { "type": "object" }
      }
    }
  }
}
