{
  "name": "json-to-mp4-framework",
  "version": "0.1.0",
  "description": "AI-agent-friendly JSON-to-MP4 video framework built on Remotion. Avoids 'PowerPoint-looking' output by using a resolved-asset pipeline, a global style/asset registry, anchor+offset templating, TTS-driven timing, and continuity-aware transitions.",
  "type": "module",
  "scripts": {
    "validate": "node src/pipelines/pipeline1-validate/validate.js",
    "resolve": "node src/pipelines/pipeline2-resolve/resolve.js",
    "render": "node src/pipelines/pipeline3-render/render.js",
    "studio": "remotion studio src/index.jsx",
    "generate:registry": "node src/registry/generateRegistryManifest.js",
    "prebuild": "npm run generate:registry",
    "build": "node scripts/render-project.mjs",
    "build:help": "node scripts/render-project.mjs --help",
    "extract:configurable": "node scripts/extract-configurable-manifests.mjs",
    "agent:project": "node scripts/agent-project-interface.js",
    "score:server": "node studio/scoring/server.mjs",
    "score:scan": "node studio/scoring/scanner.mjs",
    "insights": "node bin/video-insights.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "@remotion/paths": "^4.0.512",
    "@remotion/renderer": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@toon-format/toon": "^4.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "matter-js": "^0.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "remotion": "^4.0.0",
    "simple-icons": "^16.28.0"
  }
}
