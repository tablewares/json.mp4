[
  {
    "op": "create-project",
    "projectId": "agent-demo",
    "projectDir": "./studio/manifest/agent-demo",
    "config": { "fps": 30, "width": 1920, "height": 1080, "defaultSceneDurationInFrames": 150 },
    "theme": {
      "colors": { "shade1": "#0B0E14", "shade2": "#161B26", "main1": "#F5F7FA", "main2": "#8B93A7", "accentBg": "#3D7BFD", "transparent": "#00000000" },
      "spacing": { "sceneMargin": 96, "gutter": 32 },
      "typography": {
        "heading1": { "fontFamily": "Inter, sans-serif", "fontSize": 72, "fontWeight": 700, "lineHeight": 1.1, "colorToken": "main1" },
        "body1":    { "fontFamily": "Inter, sans-serif", "fontSize": 34, "fontWeight": 400, "lineHeight": 1.4, "colorToken": "main1" },
        "caption1": { "fontFamily": "Inter, sans-serif", "fontSize": 28, "fontWeight": 600, "lineHeight": 1.2, "colorToken": "main1" }
      }
    }
  },
  {
    "op": "create-scene-from-prompt",
    "projectDir": "./studio/manifest/agent-demo",
    "sceneId": "scene-market",
    "prompt": "Title: Markets this week. Subtitle: Tape and revenue lines. Ticker: AAPL MSFT NVDA. Bar chart: Cloud Search Retail revenue."
  }
