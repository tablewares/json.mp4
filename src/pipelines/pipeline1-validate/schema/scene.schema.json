{
  "$id": "scene.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "assets"],
  "properties": {
    "id": { "type": "string" },
    "narrationRef": { "type": "string" },
    "transitionIn": { "$ref": "transition.schema.json#/definitions/transitionRef" },
    "transitionOut": { "$ref": "transition.schema.json#/definitions/transitionRef" },
    "background": { "$ref": "shared.schema.json#/definitions/backgroundSpec" },
    "camera": { "$ref": "camera.schema.json#/definitions/cameraSpec" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetType", "anchor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "assetType": { "type": "string" },
          "anchor": {
            "type": "object",
            "required": ["position"],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
              },
              "offsetXPercent": { "type": "number", "default": 0 },
              "offsetYPercent": { "type": "number", "default": 0 }
            }
          },
          "contentOverride": { "type": "object" },
          "styleOverride": { "type": "object" },
          "enterAt": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "$ref": "shared.schema.json#/definitions/timingAnchor" }
            ],
            "description": "Legacy: fraction (0-1) of the scene's TTS/duration window, default 0. Or a timing anchor: { relativeToAsset, edge?, offsetFrames? } to fire relative to an earlier asset's enter/exit edge, { relativeToCameraAction, offsetFrames? } to fire relative to a camera action, or { offsetPercent } for a scene-end-relative percent. The referenced asset must be authored EARLIER in scene.assets."
          },
          "exitAt": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "$ref": "shared.schema.json#/definitions/timingAnchor" }
            ],
            "description": "Same shape as enterAt; legacy default 1 (scene's TTS/duration window end)."
          },
          "z": { "type": "number" },
          "motion": { "$ref": "#/definitions/motionSpec" }
        }
      }
    }
  },
  "definitions": {
    "motionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": { "$ref": "#/definitions/motionInPhase" },
        "out": { "$ref": "#/definitions/motionOutPhase" },
        "rotateDeg": {
          "type": "number",
          "description": "Static base rotation (degrees) held once mounted. Used as the default `rotate.fromDeg` when an animated rotate phase is also authored."
        },
        "rotate": { "$ref": "#/definitions/motionRotatePhase" }
      }
    },
    "motionRotatePhase": {
      "type": "object",
      "required": ["toDeg"],
      "additionalProperties": false,
      "properties": {
        "fromDeg": { "type": "number", "description": "Starting degrees. Defaults to rotateDeg (or 0)." },
        "toDeg": { "type": "number", "description": "Target degrees the rotation animates to." },
        "durationInFrames": { "type": "number", "minimum": 1, "description": "Frames the rotation animates over. Default 18." },
        "delayFrames": { "type": "number", "minimum": 0, "default": 0, "description": "Extra frames to wait, relative to startAt, before rotation begins." },
        "startAt": {
          "type": "string",
          "enum": ["afterIn", "withIn", "atFrame"],
          "default": "afterIn",
          "description": "'afterIn' (default): rotation begins once the entrance move/fade has fully resolved — i.e. after the asset has moved into the scene. 'withIn': starts at enterAtFrame, concurrent with the entrance. 'atFrame': starts at the explicit scene-local frame given by atFrame."
        },
        "atFrame": { "type": "number", "minimum": 0, "description": "Scene-local frame to start at. Only used when startAt is 'atFrame'." },
        "easing": { "type": "string", "enum": ["linear", "easeIn", "easeOut", "easeInOut"], "default": "easeInOut" }
      }
    },
    "motionInPhase": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["none", "fade", "fadeUp", "fadeDown", "fadeLeft", "fadeRight"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alias": { "type": "string", "enum": ["none", "fade", "fadeUp", "fadeDown", "fadeLeft", "fadeRight"] },
            "distancePx": { "type": "number", "minimum": 0, "description": "Travel distance in px. Default 80." },
            "durationInFrames": { "type": "number", "minimum": 1, "description": "Frames the phase animates over. Default 18." },
            "rotateFromDeg": { "type": "number", "description": "Extra rotation (degrees) that resolves to 0 as the phase completes." }
          }
        }
      ]
    },
    "motionOutPhase": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["none", "fadeOut", "fadeOutUp", "fadeOutDown", "fadeOutLeft", "fadeOutRight"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alias": { "type": "string", "enum": ["none", "fadeOut", "fadeOutUp", "fadeOutDown", "fadeOutLeft", "fadeOutRight"] },
            "distancePx": { "type": "number", "minimum": 0, "description": "Travel distance in px. Default 80." },
            "durationInFrames": { "type": "number", "minimum": 1, "description": "Frames the phase animates over. Default 18." },
            "rotateFromDeg": { "type": "number", "description": "Extra rotation (degrees) applied as the phase completes." }
          }
        }
      ]
    }
  }
}