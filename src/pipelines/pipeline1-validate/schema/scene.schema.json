{
  "$id": "scene.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "assets"],
  "properties": {
    "id": { "type": "string" },
    "narrationRef": { "type": "string" },
    "transitionIn": { "$ref": "transition.schema.json#/definitions/transitionRef" },
    "transitionOut": { "$ref": "transition.schema.json#/definitions/transitionRef" },
    "background": { "$ref": "shared.schema.json#/definitions/tokenOrLiteral" },
    "camera": { "$ref": "camera.schema.json#/definitions/cameraSpec" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetType", "anchor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "assetType": { "type": "string" },
          "anchor": {
            "type": "object",
            "required": ["position"],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
              },
              "offsetXPercent": { "type": "number", "default": 0 },
              "offsetYPercent": { "type": "number", "default": 0 }
            }
          },
          "contentOverride": { "type": "object" },
          "styleOverride": { "type": "object" },
          "enterAt": { "type": "number", "minimum": 0, "maximum": 1 },
          "exitAt": { "type": "number", "minimum": 0, "maximum": 1 },
          "z": { "type": "number" }
        }
      }
    }
  }
}