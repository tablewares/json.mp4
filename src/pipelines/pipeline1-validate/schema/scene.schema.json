{
  "$id": "scene.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "assets"],
  "properties": {
    "id": { "type": "string" },
    "narrationRef": {
      "type": "string",
      "description": "id into manifest.narration.entries; resolved timing drives this scene's duration"
    },
    "transitionIn": { "$ref": "#/definitions/transitionRef" },
    "transitionOut": { "$ref": "#/definitions/transitionRef" },
    "background": { "$ref": "#/definitions/tokenOrLiteral" },
    "camera": { "$ref": "#/definitions/cameraSpec" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetType", "anchor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "assetType": { "type": "string", "description": "must match a folder name under src/assets" },
          "anchor": {
            "type": "object",
            "required": ["position"],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
              },
              "offsetXPercent": { "type": "number", "default": 0 },
              "offsetYPercent": { "type": "number", "default": 0 }
            }
          },
          "contentOverride": { "type": "object" },
          "styleOverride": { "type": "object" },
          "enterAt": { "type": "number", "minimum": 0, "maximum": 1, "description": "fraction of scene duration" },
          "exitAt": { "type": "number", "minimum": 0, "maximum": 1 },
          "z": {
            "type": "number",
            "description": "stacking order within a scene, resolved at runtime. Lower z paints first (further from the viewer), higher z paints last (on top). Default 0. Stable sort: assets sharing a z keep their declared order. Existing manifests are unaffected."
          }
        }
      }
    }
  },
  "definitions": {
    "tokenOrLiteral": {
      "oneOf": [
        { "type": "string", "description": "a style registry token, e.g. 'shade1'" },
        { "type": "object" }
      ]
    },
    "transitionRef": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "'default' or a folder name under src/transitions" },
        "durationInFrames": { "type": "number" },
        "params": { "type": "object" },
        "effects": {
          "type": "array",
          "description": "Optional. Per-render SFX/visual effects anchored to THIS scene's own resolved ending frame (scene.durationInFrames, after TTS + transition padding). offsetPercent: 0 = exactly the scene's last frame; negative = earlier (e.g. -10 fires at 90% of the scene's length); positive = later, into the overlap the outgoing transition eats into (clamped to the scene's own duration). Omit entirely for scenes with no boundary effects.",
          "items": {
            "type": "object",
            "required": ["kind", "offsetPercent"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string", "enum": ["sfx", "visual"] },
              "offsetPercent": { "type": "number" },
              "durationInFrames": {
                "type": "number",
                "description": "sfx: omit to let the clip play its natural length. visual: how long the effect asset stays mounted (default 30)."
              },
              "path": { "type": "string", "description": "sfx only: audio file path relative to public/" },
              "volume": { "type": "number", "description": "sfx only: 0-1, default 1" },
              "assetType": { "type": "string", "description": "visual only: must match a registered assetType" },
              "anchor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "position": {
                    "type": "string",
                    "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
                  },
                  "offsetXPercent": { "type": "number", "default": 0 },
                  "offsetYPercent": { "type": "number", "default": 0 }
                }
              },
              "contentOverride": { "type": "object" },
              "styleOverride": { "type": "object" }
            }
          }
        }
      }
    },
    "cameraSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/definitions/cameraAnchor" },
        "end": { "$ref": "#/definitions/cameraAnchor" },
        "durationInFrames": { "type": "number", "minimum": 1, "description": "Optional camera motion duration; if omitted it follows the scene duration" },
        "speed": { "type": "number", "minimum": 0.01, "description": "Optional multiplier; >1 makes the camera move faster, <1 slower" },
        "actions": {
          "type": "array",
          "description": "Optional camera sequence. Each action's `at` is between 0 and 1, representing normalized scene progress.",
          "items": { "$ref": "#/definitions/cameraAction" }
        },
        "zoomStartPercent": { "type": "number", "minimum": 1, "description": "Percentage zoom at the start of the scene; 100 means no zoom" },
        "zoomEndPercent": { "type": "number", "minimum": 1, "description": "Percentage zoom at the end of the scene" },
        "zoomPercent": { "type": "number", "minimum": 1, "description": "Shortcut when both start and end zoom should match" }
      }
    },
    "cameraAction": {
      "type": "object",
      "required": ["at"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalized scene progress, from 0.0 to 1.0" },
        "anchor": { "$ref": "#/definitions/cameraAnchor" },
        "zoomPercent": { "type": "number", "minimum": 1, "description": "Zoom at this point in the camera path" }
      }
    },
    "cameraAnchor": {
      "type": "object",
      "required": ["position"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "string",
          "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
        },
        "offsetXPercent": { "type": "number", "default": 0 },
        "offsetYPercent": { "type": "number", "default": 0 }
      }
    }
  }
}
