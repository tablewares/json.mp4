{
  "$id": "camera.schema.json",
  "definitions": {
    "cameraSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/definitions/cameraAnchor" },
        "end": { "$ref": "#/definitions/cameraAnchor" },
        "durationInFrames": { "type": "number", "minimum": 1 },
        "speed": { "type": "number", "minimum": 0.01 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/cameraAction" }
        },
        "zoomStartPercent": { "type": "number", "minimum": 1 },
        "zoomEndPercent": { "type": "number", "minimum": 1 },
        "zoomPercent": { "type": "number", "minimum": 1 },
        "easeZoom": { "type": "boolean" }
      }
    },
    "cameraAction": {
      "type": "object",
      "required": ["at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "at": { "type": "number", "minimum": 0, "maximum": 1 },
        "anchor": { "$ref": "#/definitions/cameraAnchor" },
        "zoomPercent": { "type": "number", "minimum": 1 }
      }
    },
    "cameraAnchor": {
      "type": "object",
      "oneOf": [
        {
          "required": ["position"],
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": "string",
              "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]
            },
            "offsetXPercent": { "type": "number", "default": 0 },
            "offsetYPercent": { "type": "number", "default": 0 }
          }
        },
        {
          "required": ["followAssetId"],
          "additionalProperties": false,
          "properties": {
            "followAssetId": { "type": "string" },
            "edge": { "type": "string", "enum": ["enter", "exit"], "default": "enter" },
            "offsetXPercent": { "type": "number", "default": 0 },
            "offsetYPercent": { "type": "number", "default": 0 }
          }
        }
      ]
    }
  }
}