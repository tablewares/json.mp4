{
  "$id": "camera.schema.json",
  "definitions": {
    "cameraSpec": {
      "description": "A camera spec, or a \"$alias\": \"camera.<name>\" shorthand (e.g. camera.dollyIn, camera.overshootHold) expanded to the object shape below by resolveAliasesDeep in pipeline2.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/definitions/cameraAnchor" },
            "end": { "$ref": "#/definitions/cameraAnchor" },
            "durationInFrames": { "type": "number", "minimum": 1 },
            "speed": { "type": "number", "minimum": 0.01 },
            "actions": {
              "type": "array",
              "items": { "$ref": "#/definitions/cameraAction" }
            },
            "zoomStartPercent": { "type": "number", "minimum": 1 },
            "zoomEndPercent": { "type": "number", "minimum": 1 },
            "zoomPercent": { "type": "number", "minimum": 1 },
            "easeZoom": { "type": "boolean" },
            "easing": { "$ref": "#/definitions/cameraEasing" }
          }
        },
        { "$ref": "shared.schema.json#/definitions/aliasRef" }
      ]
    },
    "cameraAction": {
      "type": "object",
      "required": ["at"],
      "additionalProperties": false,
      "description": "One keyframe in a multi-leg camera move. `at` is the PRIMARY, exact-first field — a fraction [0,1] of the camera's own motion duration (legacy, unchanged), OR a timing-anchor object (relativeToAsset/relativeToCameraAction/relativeToWord/offsetPercent — shared.schema.json#/definitions/timingAnchor) resolved to a scene-local frame and then converted to camera-progress internally, the same 'exact-first, legacy-percent-as-fallback' pattern effects.schema.json's `frame` uses.",
      "properties": {
        "id": { "type": "string" },
        "at": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "$ref": "shared.schema.json#/definitions/timingAnchor" }
          ]
        },
        "anchor": { "$ref": "#/definitions/cameraAnchor" },
        "zoomPercent": { "type": "number", "minimum": 1 },
        "easing": { "$ref": "#/definitions/cameraEasing" }
      }
    },
    "cameraEasing": {
      "type": "string",
      "enum": ["linear", "easeIn", "easeOut", "easeInOut"],
      "description": "Shapes the pace of the leg LEAVING this action (or, on the top-level start/end shorthand, the whole move) toward the next action. Default 'linear'. 'easeOut' gives a fast launch settling into place — the 'swoosh' zoom. Applies to both anchor pan and, when easeZoom is true, zoom."
    },
    "cameraAnchor": {
      "type": "object",
      "oneOf": [
        {
          "required": ["position"],
          "additionalProperties": false,
          "properties": {
            "position": { "$ref": "shared.schema.json#/definitions/cornerPosition" },
            "offsetXPercent": { "$ref": "shared.schema.json#/definitions/offsetXPercent" },
            "offsetYPercent": { "$ref": "shared.schema.json#/definitions/offsetYPercent" }
          }
        },
        {
          "required": ["followAssetId"],
          "additionalProperties": false,
          "properties": {
            "followAssetId": { "type": "string" },
            "edge": { "$ref": "shared.schema.json#/definitions/enterExitEdge" },
            "offsetXPercent": { "$ref": "shared.schema.json#/definitions/offsetXPercent" },
            "offsetYPercent": { "$ref": "shared.schema.json#/definitions/offsetYPercent" }
          }
        }
      ]
    }
  }
}
