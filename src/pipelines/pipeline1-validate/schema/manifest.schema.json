{
  "$id": "manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "config", "styles", "scenes"],
  "properties": {
    "projectId": { "type": "string" },
    "config": { "type": "string", "description": "relative path to config.json" },
    "styles": { "type": "string", "description": "relative path to the style registry json" },
    "narration": {
      "type": "object",
      "description": "optional: id/text pairs + transcript, fed to ttsTiming",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "description": "Spoken narration entry, fed to TTS synthesis.",
                "required": ["id", "text"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" }
                }
              },
              {
                "type": "object",
                "description": "Silent block: no narration segment, but still occupies a real span of the composition's audio timeline. Positioned purely by its place in the entries[] array relative to its neighboring entry ids — never by an absolute offset. A scene can set narrationRef to a silence entry's id to size its duration off durationSeconds with no TTS synthesis involved.",
                "required": ["id", "kind", "durationSeconds"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "type": "string", "const": "silence" },
                  "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            ]
          }
        },
        "fullTranscript": { "type": "string" }
      }
    },
    "audioOverlay": {
      "type": "array",
      "description": "Optional hand-authored audio tracks. Ignored for narrated projects — TTS's real audio overrides this (see resolve.js).",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "path": { "type": "string", "description": "relative to public/" },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
        }
      }
    },
    "music": {
      "type": "array",
      "description": "Optional background music tracks, layered under narration/audioOverlay at reduced volume. Independent of TTS timing; omit for silent-of-music projects (strict no-op).",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "relative to public/" },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
          "start": { "type": "number", "minimum": 0, "default": 0, "description": "seconds into the composition timeline" },
          "end": { "type": "number", "minimum": 0, "description": "seconds; omit to run for the full composition duration" },
          "loop": { "type": "boolean", "default": true },
          "fadeInSeconds": { "type": "number", "minimum": 0, "default": 0 },
          "fadeOutSeconds": { "type": "number", "minimum": 0, "default": 0 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "relative path to this scene's json file" }
        }
      }
    },
    "physicsPresets": {
      "type": "string",
      "description": "Optional: relative path to a JSON file of reusable named physics specs, referenceable from scenes as \"$physics.<path>\" (e.g. \"$physics.presets.bouncyBall\")."
    }
  }
}