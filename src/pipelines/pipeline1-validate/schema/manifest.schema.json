{
  "$id": "manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "config", "styles", "scenes"],
  "properties": {
    "projectId": { "type": "string" },
    "config": { "type": "string", "description": "relative path to config.json" },
    "styles": { "type": "string", "description": "relative path to the style registry json" },
    "narration": {
      "type": "object",
      "description": "optional: id/text pairs + transcript, fed to ttsTiming",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "fullTranscript": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "relative path to this scene's json file" }
        }
      }
    }
  }
}
