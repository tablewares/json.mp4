id: scene-hook
narrationRef: ""
background: shade1
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
  effects[2]:
    - id: shatter-thud
      kind: sfx
      offsetPercent: -10
      path: audio/sfx.mp3
      volume: 0.9
    - id: shatter-flash
      kind: visual
      offsetPercent: 0
      durationInFrames: 10
      assetType: ImageReveal
      anchor:
        position: center
      contentOverride:
        src: assets/white.avif
        alt: ""
      styleOverride:
        width: 1920
        height: 1080
        borderRadius: 0
        revealDirection: center-out
assets[3]:
  - id: kicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 22
    contentOverride:
      text: "A TOON BOILERPLATE STORY"
    styleOverride:
      typography: kicker1
      align: left
      width: 360
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: headline
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      text: "One scene. Three transitions. Real layout."
    styleOverride:
      typography: heading1
      align: center
      width: 1380
      height: 120
    enterAt: 0.05
    exitAt: 0.92
  - id: subline
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: 10
    contentOverride:
      text: "Built from a toon boilerplate with multiple assets, transitions, and continuity."
    styleOverride:
      typography: body1
      align: center
      width: 1200
      height: 130
    enterAt: 0.12
    exitAt: 0.92
