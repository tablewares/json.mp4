id: scene-globe
narrationRef: ""
background: shade1
transitionOut:
  type: slideContinuity
  durationInFrames: 24
  params:
    carryAssetId: heroImage
assets[4]:
  - id: kicker2
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 8
    contentOverride:
      text: "01 / The boilerplate is a globe"
    styleOverride:
      typography: kicker1
      align: left
      width: 480
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: heroImage
    assetType: ImageReveal
    anchor:
      position: center
      offsetXPercent: -10
      offsetYPercent: 0
    contentOverride:
      src: assets/network.png
      alt: "A globe of network nodes joined by glowing edges, with a bright packet arc bridging two nodes."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      width: 640
      height: 640
      borderRadius: 24
    enterAt: 0.05
    exitAt: 0.95
  - id: globeSub
    assetType: TextBlock
    anchor:
      position: right
      offsetXPercent: -8
      offsetYPercent: 0
    contentOverride:
      text: "Your scene does not teleport. It carries."
    styleOverride:
      typography: heading2
      align: right
      width: 560
      height: 200
    enterAt: 0.35
    exitAt: 0.95
  - id: kineticStrip
    assetType: KineticText
    anchor:
      position: bottom
      offsetXPercent: 0
      offsetYPercent: 8
    contentOverride:
      text: "Toon tokens anchors timing transitions registry resolve render"
    styleOverride:
      typography: caption1
      easing: snappySpring
      staggerFrames: 4
      wordPopScale: 1.1
      align: center
      width: 1400
      height: 80
    enterAt: 0.2
    exitAt: 0.95
