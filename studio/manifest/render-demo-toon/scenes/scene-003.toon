id: scene-arrive
narrationRef: ""
background: shade2
assets[4]:
  - id: arriveKicker
    assetType: TextBlock
    anchor:
      position: top
      offsetXPercent: -34
      offsetYPercent: 16
    contentOverride:
      text: "02 / It arrives"
    styleOverride:
      typography: kicker1
      align: left
      width: 320
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: heroImage
    assetType: ImageReveal
    anchor:
      position: top-right
      offsetXPercent: -14
      offsetYPercent: 20
    contentOverride:
      src: assets/destination.png
      alt: "Server rack landing dock with LEDs lit and an arrival beam."
    styleOverride:
      revealDirection: left-to-right
      easing: gentleSpring
      width: 480
      height: 480
      borderRadius: 16
    enterAt: 0.04
    exitAt: 0.95
  - id: arriveHead
    assetType: TextBlock
    anchor:
      position: bottom-left
      offsetXPercent: 8
      offsetYPercent: -16
    contentOverride:
      text: "Scene rendered."
    styleOverride:
      typography: heading1
      align: left
      width: 720
      height: 120
    enterAt: 0.12
    exitAt: 0.95
  - id: arriveSub
    assetType: TextBlock
    anchor:
      position: bottom-left
      offsetXPercent: 8
      offsetYPercent: -3
    contentOverride:
      text: "Three scenes, four asset types, two transition types, one boilerplate."
    styleOverride:
      typography: body1
      align: left
      width: 1080
      height: 130
    enterAt: 0.25
    exitAt: 0.95
