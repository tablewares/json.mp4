{
  "id": "scene-market",
  "narrationRef": "n1",
  "background": "shade1",
  "transitionOut": {
    "type": "shatterWipe",
    "durationInFrames": 22,
    "params": {
      "cols": 6,
      "rows": 4,
      "throwDistance": 220
    }
  },
  "assets": [
    {
      "id": "title",
      "assetType": "TextBlock",
      "anchor": {
        "position": "top-left",
        "offsetXPercent": 6,
        "offsetYPercent": 6
      },
      "contentOverride": {
        "text": "Markets this quarter"
      },
      "styleOverride": {
        "typography": "heading1",
        "align": "left"
      },
      "enterAt": 0,
      "exitAt": 0.95
    },
    {
      "id": "subhead",
      "assetType": "TextBlock",
      "anchor": {
        "position": "top-left",
        "offsetXPercent": 6,
        "offsetYPercent": 13
      },
      "contentOverride": {
        "text": "Revenue lines and tape of the week."
      },
      "styleOverride": {
        "typography": "caption1",
        "align": "left"
      },
      "enterAt": 0.03,
      "exitAt": 0.95
    },
    {
      "id": "ticker",
      "assetType": "TickerTape",
      "anchor": {
        "position": "center",
        "offsetXPercent": 0,
        "offsetYPercent": -14
      },
      "contentOverride": {
        "tickers": [
          {
            "symbol": "AAPL",
            "price": 224.31,
            "change": 1.42
          },
          {
            "symbol": "MSFT",
            "price": 421.07,
            "change": -0.86
          },
          {
            "symbol": "NVDA",
            "price": 138.25,
            "change": 6.17
          },
          {
            "symbol": "GOOGL",
            "price": 179.58,
            "change": -1.03
          },
          {
            "symbol": "AMZN",
            "price": 201.97,
            "change": 0.44
          },
          {
            "symbol": "TSLA",
            "price": 248.66,
            "change": 4.92
          },
          {
            "symbol": "META",
            "price": 565.34,
            "change": -0.31
          }
        ]
      },
      "styleOverride": {
        "typography": "caption1",
        "width": 1500,
        "trackHeight": 84,
        "scrollPxPerSec": 110,
        "borderLine": "#2A3142"
      },
      "enterAt": 0.05,
      "exitAt": 1
    },
    {
      "id": "bars",
      "assetType": "BarChartRace",
      "anchor": {
        "position": "bottom",
        "offsetXPercent": 0,
        "offsetYPercent": 6
      },
      "contentOverride": {
        "bars": [
          {
            "label": "Cloud",
            "value": 19000000000,
            "fillStyle": "#3D7BFD"
          },
          {
            "label": "Search",
            "value": 88000000000,
            "fillStyle": "#16C784"
          },
          {
            "label": "Retail",
            "value": 157000000000,
            "fillStyle": "#F5A623"
          },
          {
            "label": "Riverplace",
            "value": 38500000000,
            "fillStyle": "#C04CFD"
          }
        ]
      },
      "styleOverride": {
        "typography": "caption1",
        "width": 1400,
        "height": 560,
        "valueFormat": "compact",
        "sortByValue": "desc",
        "staggerFrames": 8
      },
      "enterAt": 0.08,
      "exitAt": 1
    }
  ],
  "effects": [
    {
      "id": "shatter-thud",
      "kind": "sfx",
      "offsetPercent": -3,
      "path": "audio/sfx.mp3",
      "volume": 0.9
    },
    {
      "id": "shatter-flash",
      "kind": "visual",
      "offsetPercent": 0,
      "durationInFrames": 10,
      "assetType": "ImageReveal",
      "anchor": {
        "position": "center"
      },
      "contentOverride": {
        "src": "assets/destination.png",
        "alt": ""
      },
      "styleOverride": {
        "width": 1920,
        "height": 1080,
        "borderRadius": 0,
        "revealDirection": "center-out"
      }
    }
  ]
}
