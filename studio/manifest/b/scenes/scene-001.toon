id: scene-numbers
narrationRef: ""
background: shade1
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
assets[5]:
  - id: kicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "01 / New primitives"
    styleOverride:
      typography: kicker1
      align: left
      width: 400
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: headline
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 18
    contentOverride:
      text: "Three new building blocks for every render"
    styleOverride:
      typography: heading2
      align: left
      width: 1200
      height: 140
    enterAt: 0.05
    exitAt: 0.92
  - id: statCount
    assetType: NumberStat
    anchor:
      position: bottom-left
      offsetXPercent: 8
      offsetYPercent: -8
    contentOverride:
      value: 3
      label: "new asset types"
    styleOverride:
      typography: heading1
      labelTypography: caption1
      valueFormat: number
      align: left
      width: 480
      height: 220
    enterAt: 0.18
    exitAt: 0.95
  - id: statDeps
    assetType: NumberStat
    anchor:
      position: bottom
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      value: 0
      label: "new dependencies"
    styleOverride:
      typography: heading1
      labelTypography: caption1
      valueFormat: number
      align: center
      width: 480
      height: 220
    enterAt: 0.26
    exitAt: 0.95
  - id: statSpring
    assetType: NumberStat
    anchor:
      position: bottom-right
      offsetXPercent: -8
      offsetYPercent: -8
    contentOverride:
      value: 100
      label: "spring-driven timing"
    styleOverride:
      typography: heading1
      labelTypography: caption1
      valueFormat: number
      suffix: "%"
      align: right
      width: 480
      height: 220
    enterAt: 0.34
    exitAt: 0.95
