id: scene-checklist
narrationRef: ""
background: shade2
transitionOut:
  type: default
  durationInFrames: 18
assets[3]:
  - id: kicker2
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "02 / What each one does"
    styleOverride:
      typography: kicker1
      align: left
      width: 480
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: primitiveList
    assetType: ListReveal
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -6
    contentOverride:
      items[3]:
        - "NumberStat — animated counters and KPIs"
        - "ListReveal — staggered bullets, numbers, checks"
        - "CodeBlock — line-by-line code reveal"
    styleOverride:
      typography: body1
      easing: snappySpring
      staggerFrames: 8
      markerStyle: check
      markerFill: "#16C784"
      itemGap: 28
      align: left
      width: 1400
    enterAt: 0.12
    exitAt: 0.95
  - id: caption
    assetType: TextBlock
    anchor:
      position: bottom
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      text: "Every primitive owns its own animation budget."
    styleOverride:
      typography: caption1
      align: center
      width: 1000
      height: 60
    enterAt: 0.6
    exitAt: 0.95
