id: scene-hook
narrationRef: ""
background: shade1
camera:
  start:
    position: center
    offsetXPercent: 0
    offsetYPercent: 0
  end:
    position: top-left
    offsetXPercent: 6
    offsetYPercent: 8
  speed: 2
  zoomStartPercent: 100
  zoomEndPercent: 108
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
  effects[2]:
    - id: shatter-thud
      kind: sfx
      offsetPercent: -10
      path: audio/sfx.mp3
      volume: 0.9
    - id: shatter-flash
      kind: visual
      offsetPercent: 0
      durationInFrames: 10
      assetType: ImageReveal
      anchor:
        position: center
      contentOverride:
        src: assets/white.avif
        alt: ""
      styleOverride:
        width: 1920
        height: 1080
        borderRadius: 0
        revealDirection: center-out
assets[4]:
  - id: kicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "COMPOSITION STUDY"
    styleOverride:
      typography: kicker
      align: left
      width: 360
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: dateKicker
    assetType: TextBlock
    anchor:
      position: top-right
      offsetXPercent: -8
      offsetYPercent: 10
    contentOverride:
      text: "PRINCIPLE §9 · Z-PATTERN"
    styleOverride:
      typography: kicker
      align: right
      width: 320
      height: 40
    enterAt: 0.05
    exitAt: 0.9
  - id: headline
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      text: "Layout, before content."
    styleOverride:
      typography: displayOnDark
      align: center
      width: 1380
      height: 240
    enterAt: 0.08
    exitAt: 0.95
  - id: seal
    assetType: ImageReveal
    anchor:
      position: bottom
      offsetXPercent: 0
      offsetYPercent: -12
    contentOverride:
      src: assets/spike-mark-on-dark.svg
      alt: "spike mark"
    styleOverride:
      borderRadius: 0
      easing: gentleSpring
      revealDirection: center-out
      width: 160
      height: 160
    enterAt: 0.4
    exitAt: 0.95
