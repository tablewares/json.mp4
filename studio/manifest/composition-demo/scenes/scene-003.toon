id: scene-stats
narrationRef: ""
background: surfaceCard
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
assets[4]:
  - id: kicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "PRINCIPLE §5 · PROXIMITY / MIRRORED PAIRS"
    styleOverride:
      typography: kicker
      align: left
      width: 520
      height: 40
    enterAt: 0
    exitAt: 0.9
  - id: headline
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      text: "Two facts, one comparison — share a band, mirror the offsets."
    styleOverride:
      typography: heading1
      align: center
      width: 1500
      height: 200
    enterAt: 0.08
    exitAt: 0.95
  - id: statL
    assetType: NumberStat
    anchor:
      position: bottom-left
      offsetXPercent: 16
      offsetYPercent: -16
    contentOverride:
      value: 9
      label: "HOLDS THE FOCAL POINT"
    styleOverride:
      typography: stat
      labelTypography: statLabel
      easing: snappySpring
      valueFill: "#cc785c"
      labelFill: "#3d3d3a"
      align: center
      labelPosition: bottom
      width: 520
      height: 260
    enterAt: 0.25
    exitAt: 0.95
  - id: statR
    assetType: NumberStat
    anchor:
      position: bottom-right
      offsetXPercent: -16
      offsetYPercent: -16
    contentOverride:
      value: 1
      label: "IDEA PER BEAT"
    styleOverride:
      typography: stat
      labelTypography: statLabel
      easing: snappySpring
      valueFill: "#cc785c"
      labelFill: "#3d3d3a"
      align: center
      labelPosition: bottom
      width: 520
      height: 260
    enterAt: 0.34
    exitAt: 0.95
