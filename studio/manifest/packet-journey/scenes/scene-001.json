{
  "id": "scene-hook",
  "background": "shade1",
"transitionOut": {
  "type": "shatterWipe",
  "durationInFrames": 22,
  "params": { "cols": 6, "rows": 4, "throwDistance": 220 },
  "effects": [
    {
      "id": "shatter-thud",
      "kind": "sfx",
      "offsetPercent": -3,
      "path": "audio/sfx.mp3",
      "volume": 0.9
    },
    {
      "id": "shatter-flash",
      "kind": "visual",
      "offsetPercent": 0,
      "durationInFrames": 10,
      "assetType": "ImageReveal",
      "anchor": { "position": "center" },
      "contentOverride": { "src": "assets/destination.png", "alt": "" },
      "styleOverride": { "width": 1920, "height": 1080, "borderRadius": 0, "revealDirection": "center-out" }
    }
  ]
},
  "assets": [
    {
      "id": "kicker",
      "assetType": "TextBlock",
      "anchor": { "position": "top-left", "offsetXPercent": 8, "offsetYPercent": 22 },
      "contentOverride": { "text": "A PACKET JOURNEY" },
      "styleOverride": { "typography": "kicker1", "align": "left" },
      "enterAt": 0,
      "exitAt": 0.9
    },
    {
      "id": "headline",
      "assetType": "TextBlock",
      "anchor": { "position": "center", "offsetXPercent": 0, "offsetYPercent": -4 },
      "contentOverride": { "text": "One bit. The whole internet." },
      "styleOverride": { "typography": "heading1", "align": "center" },
      "enterAt": 0.05,
      "exitAt": 0.92
    },
    {
      "id": "subline",
      "assetType": "TextBlock",
      "anchor": { "position": "center", "offsetXPercent": 0, "offsetYPercent": 6 },
      "contentOverride": { "text": "What happens in the 42 milliseconds between send and arrive?" },
      "styleOverride": { "typography": "body1", "align": "center" },
      "enterAt": 0.12,
      "exitAt": 0.92
    }
  ]
}
