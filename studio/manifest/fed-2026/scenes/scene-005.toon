id: scene-numbers
narrationRef: n5
background: surfaceCard
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
assets[6]:
  - id: numbersKicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "04 / The numbers that matter"
    styleOverride:
      typography: captionUppercase
      align: left
      easing: gentleSpring
      width: 560
      height: 50
    enterAt: 0
    exitAt: 0.9
  - id: numbersHead
    assetType: TextBlock
    anchor:
      position: top
      offsetXPercent: 0
      offsetYPercent: 20
    contentOverride:
      text: "Four figures to carry into Monday."
    styleOverride:
      typography: displayLg
      align: center
      easing: gentleSpring
      width: 1500
      height: 160
    enterAt: 0.06
    exitAt: 0.92
  - id: stat30y
    assetType: NumberStat
    anchor:
      position: bottom-left
      offsetXPercent: 14
      offsetYPercent: 30
    contentOverride:
      value: 5.84
      label: "30yr Treasury yield"
    styleOverride:
      typography: displayXl
      labelTypography: caption
      easing: snappySpring
      valueFill: "#141413"
      labelFill: "#6c6a64"
      canvasFill: "#faf9f5"
      borderLine: "#e6dfd8"
      borderRadius: 16
      labelPosition: top
      decimals: 2
      suffix: "%"
      width: 540
      height: 280
    enterAt: 0.2
    exitAt: 0.95
  - id: statOdds
    assetType: NumberStat
    anchor:
      position: bottom-right
      offsetXPercent: -14
      offsetYPercent: 30
    contentOverride:
      value: 33
      label: "Sept hike odds (%)"
    styleOverride:
      typography: displayXl
      labelTypography: caption
      easing: snappySpring
      valueFill: "#cc785c"
      labelFill: "#6c6a64"
      canvasFill: "#faf9f5"
      borderLine: "#cc785c"
      borderRadius: 16
      labelPosition: top
      suffix: "%"
      width: 540
      height: 280
    enterAt: 0.34
    exitAt: 0.95
  - id: statTech
    assetType: NumberStat
    anchor:
      position: bottom-left
      offsetXPercent: 14
      offsetYPercent: 4
    contentOverride:
      value: 7
      label: "FOMC meetings tech fell (of last 8)"
    styleOverride:
      typography: displayXl
      labelTypography: caption
      easing: snappySpring
      valueFill: "#141413"
      labelFill: "#6c6a64"
      canvasFill: "#faf9f5"
      borderLine: "#e6dfd8"
      borderRadius: 16
      labelPosition: top
      suffix: " / 8"
      width: 540
      height: 220
    enterAt: 0.48
    exitAt: 0.95
  - id: statXlf
    assetType: NumberStat
    anchor:
      position: bottom-right
      offsetXPercent: -14
      offsetYPercent: 4
    contentOverride:
      value: 0.34
      label: "XLF daily change"
    styleOverride:
      typography: displayXl
      labelTypography: caption
      easing: snappySpring
      valueFill: "#5db872"
      labelFill: "#6c6a64"
      canvasFill: "#faf9f5"
      borderLine: "#e6dfd8"
      borderRadius: 16
      labelPosition: top
      decimals: 2
      prefix: "+"
      width: 540
      height: 220
    enterAt: 0.6
    exitAt: 0.95
