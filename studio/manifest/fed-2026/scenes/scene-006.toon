id: scene-playbook
narrationRef: n6
background: canvas
transitionOut:
  type: slideContinuity
  durationInFrames: 24
  params:
    carryAssetId: closeSeal
  effects[1]:
    - id: book-whoosh
      kind: sfx
      offsetPercent: -6
      path: audio/sfx.mp3
      volume: 0.7
assets[4]:
  - id: bookKicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "05 / The trader playbook"
    styleOverride:
      typography: captionUppercase
      align: left
      easing: gentleSpring
      width: 560
      height: 50
    enterAt: 0
    exitAt: 0.9
  - id: bookHead
    assetType: TextBlock
    anchor:
      position: top
      offsetXPercent: 0
      offsetYPercent: 18
    contentOverride:
      text: "Position for September."
    styleOverride:
      typography: displayLg
      align: center
      easing: gentleSpring
      width: 1500
      height: 160
    enterAt: 0.06
    exitAt: 0.92
  - id: playbook
    assetType: ListReveal
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: 14
    contentOverride:
      items[5]:
        - Fade the tech sell-the-news tilt
        - Go long financials (XLF) on the NIM tailwind
        - Watch the 30yr for the real tightening signal
        - Track oil and the dollar; the Iran shock sets headline risk
        - Keep Sep 16 FOMC hedges on
    styleOverride:
      typography: titleMd
      easing: snappySpring
      staggerFrames: 8
      markerStyle: check
      markerFill: "#cc785c"
      itemGap: 20
      align: left
      width: 1200
      height: 420
    enterAt: 0.22
    exitAt: 0.95
  - id: closeSeal
    assetType: ImageReveal
    anchor:
      position: bottom-right
      offsetXPercent: -8
      offsetYPercent: 8
    contentOverride:
      src: assets/fed-seal.svg
      alt: "Federal Reserve seal mark, bookend carried into the close."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      borderRadius: 0
      width: 120
      height: 120
    enterAt: 0.5
    exitAt: 0.95
