id: scene-statement
narrationRef: n3
background: surfaceDark
transitionOut:
  type: shatterWipe
  durationInFrames: 22
  params:
    cols: 6
    rows: 4
    throwDistance: 220
assets[4]:
  - id: statementKicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 10
    contentOverride:
      text: "02 / The statement"
    styleOverride:
      typography: captionUppercase
      align: left
      easing: gentleSpring
      width: 420
      height: 50
    enterAt: 0
    exitAt: 0.9
  - id: statementHead
    assetType: TextBlock
    anchor:
      position: top
      offsetXPercent: 0
      offsetYPercent: 26
    contentOverride:
      text: "Read it like a trader would."
    styleOverride:
      typography: displayMd
      align: center
      easing: gentleSpring
      width: 1500
      height: 120
    enterAt: 0.05
    exitAt: 0.92
  - id: codeVerdict
    assetType: CodeBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: 12
    contentOverride:
      language: fomc
      code: "target_range: 3.50 - 3.75 pct\nvote: 9 - 3 (most divided since 2016)\ndecision: hold\ninflation_target: 2.0 pct\nchair: kevin warsh\nstance: a review, not a pause\ncut_2026: not priced"
      highlightLines: [2, 3, 6]
    styleOverride:
      monoFontFamily: "\"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace"
      badgeTypography: caption
      easing: snappySpring
      fontSizePx: 22
      lineHeightPx: 1.6
      staggerFrames: 4
      showLineNumbers: true
      showWindowChrome: true
      backgroundFill: "#1f1e1b"
      borderLine: "#252320"
      borderRadius: 16
      textFill: "#faf9f5"
      lineNumberFill: "#8e8b82"
      accentFill: "#cc785c"
      width: 1080
      height: 520
    enterAt: 0.2
    exitAt: 0.95
  - id: sealOnDark
    assetType: ImageReveal
    anchor:
      position: top-right
      offsetXPercent: -8
      offsetYPercent: 6
    contentOverride:
      src: assets/fed-seal-on-dark.svg
      alt: "Federal Reserve seal mark, cream variant on dark navy."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      borderRadius: 0
      width: 96
      height: 96
    enterAt: 0.1
    exitAt: 0.95
