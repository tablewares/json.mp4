id: scene-hook
narrationRef: n1
background: canvas
transitionOut:
  type: slideContinuity
  durationInFrames: 24
  params:
    carryAssetId: fedSeal
assets[5]:
  - id: brandMark
    assetType: ImageReveal
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 8
    contentOverride:
      src: assets/spike-mark.svg
      alt: "Editorial spike-mark glyph prefixing the FED WATCH kicker."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      borderRadius: 0
      width: 56
      height: 56
    enterAt: 0
    exitAt: 0.9
  - id: kicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 12
      offsetYPercent: 9
    contentOverride:
      text: "FED WATCH"
    styleOverride:
      typography: captionUppercase
      align: left
      easing: gentleSpring
      width: 360
      height: 50
    enterAt: 0
    exitAt: 0.9
  - id: dateKicker
    assetType: TextBlock
    anchor:
      position: top-right
      offsetXPercent: -8
      offsetYPercent: 9
    contentOverride:
      text: "JULY 29 2026"
    styleOverride:
      typography: captionUppercase
      align: right
      easing: gentleSpring
      width: 320
      height: 50
    enterAt: 0
    exitAt: 0.9
  - id: headline
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -8
    contentOverride:
      text: "The Fed held. Three disagreed."
    styleOverride:
      typography: displayXl
      align: center
      easing: gentleSpring
      width: 1560
      height: 220
    enterAt: 0.1
    exitAt: 0.92
  - id: fedSeal
    assetType: ImageReveal
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: 14
    contentOverride:
      src: assets/fed-seal.svg
      alt: "Line-art Federal Reserve seal mark."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      borderRadius: 0
      width: 240
      height: 240
    enterAt: 0.3
    exitAt: 0.95
