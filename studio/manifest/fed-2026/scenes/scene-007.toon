id: scene-close
narrationRef: n7
background: surfaceDark
assets[4]:
  - id: closeKicker
    assetType: TextBlock
    anchor:
      position: top-left
      offsetXPercent: 8
      offsetYPercent: 12
    contentOverride:
      text: "* ANTHROPIC FED WATCH"
    styleOverride:
      typography: captionUppercase
      align: left
      easing: gentleSpring
      width: 480
      height: 50
    enterAt: 0
    exitAt: 0.95
  - id: closeHead
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: -6
    contentOverride:
      text: "Until then, trade the divergence."
    styleOverride:
      typography: displayXl
      align: center
      easing: gentleSpring
      width: 1600
      height: 200
    enterAt: 0.1
    exitAt: 0.95
  - id: closeSub
    assetType: TextBlock
    anchor:
      position: center
      offsetXPercent: 0
      offsetYPercent: 12
    contentOverride:
      text: "Next signal: September 16 FOMC."
    styleOverride:
      typography: titleLg
      align: center
      easing: gentleSpring
      width: 1500
      height: 100
    enterAt: 0.4
    exitAt: 0.95
  - id: closeSeal
    assetType: ImageReveal
    anchor:
      position: bottom
      offsetXPercent: 0
      offsetYPercent: 12
    contentOverride:
      src: assets/fed-seal-on-dark.svg
      alt: "Federal Reserve seal mark, cream on dark, closing bookend."
    styleOverride:
      revealDirection: center-out
      easing: gentleSpring
      borderRadius: 0
      width: 180
      height: 180
    enterAt: 0.25
    exitAt: 0.95
